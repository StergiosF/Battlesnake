{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "plugins": ["jest"],
      "env": {
        "jest/globals": true
      },
      "extends": ["plugin:jest/recommended"]
    }
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn"
  }
}
